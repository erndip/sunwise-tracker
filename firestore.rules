rules_version = '2';

// Security model for Sunwise Tracker.
//
// This is the real trust boundary for the app — the public Firebase web config
// in src/lib/firebase.ts is NOT a secret. These rules ensure a signed-in user
// can only ever read or write documents under their own UID, and that nobody
// can touch anything while signed out.
//
// Deploy from the Firebase console (Firestore Database → Rules → Publish) or
// via the CLI: `firebase deploy --only firestore:rules`.

service cloud.firestore {
  match /databases/{database}/documents {

    // Each user's tanning sessions live at: users/{uid}/sessions/{sessionId}
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Everything else is denied by default.
  }
}
